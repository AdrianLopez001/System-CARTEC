# Copie este arquivo para ".env" (mesma pasta) e preencha com valores reais
# ANTES de rodar "docker compose up" no VPS. O ".env" nunca vai pro git.

# Login do sistema (troque a senha - "admin" e so exemplo)
APP_SECURITY_ADMIN_USERNAME=admin
APP_SECURITY_ADMIN_PASSWORD=troque-esta-senha

# Token compartilhado entre o app Java e o bot do WhatsApp (server-to-server,
# nao e senha de usuario) - qualquer string longa e aleatoria serve. Gerar
# uma nova, por exemplo com: openssl rand -hex 24
WHATSAPP_BOT_TOKEN=troque-por-um-token-aleatorio
